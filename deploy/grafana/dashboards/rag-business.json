{
  "uid": "rag-business",
  "title": "RAG 业务运营（业务方/管理层）",
  "tags": ["rag", "business"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "uid": "prom" } }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "24h 活跃用户 (DAU)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "rag_active_users_24h" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 20 }, { "color": "green", "value": 50 } ] } } , "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "7d 活跃用户 (WAU)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "rag_active_users_7d" }],
      "fieldConfig": { "defaults": { "unit": "short" } , "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "24h 人均提问",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "rag_questions_per_user_24h" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 } , "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "问题重复率 (24h)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "rag_repeat_question_ratio_24h" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.35 } ] } } , "overrides": [] }
    },

    {
      "id": 10, "type": "timeseries", "title": "点赞 / 点踩趋势（1h 滚动）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (rating) (rate(rag_feedback_total[1h]))", "legendFormat": "{{rating}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } , "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 11, "type": "timeseries", "title": "点踩率（窗口 1h，需样本量 ≥20）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(rag_feedback_total{rating=\"down\"}[1h])) / clamp_min(sum(rate(rag_feedback_total[1h])), 1e-9)", "legendFormat": "downvote_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.2 } ] } } , "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } }
    },

    {
      "id": 20, "type": "barchart", "title": "点踩原因分布",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "rate(rag_feedback_reason_total[1h])", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } , "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] } }
    },
    {
      "id": 21, "type": "barchart", "title": "badcase 归因分布",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "rag_badcase_attribution_total", "legendFormat": "{{attribution}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } , "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] } }
    },

    {
      "id": 30, "type": "stat", "title": "badcase 待处理",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "rag_badcase_open_total" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 20 } ] } } , "overrides": [] }
    },
    {
      "id": 31, "type": "stat", "title": "badcase 总量",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "refId": "A", "expr": "sum(rag_badcase_total)", "legendFormat": "total" }],
      "fieldConfig": { "defaults": { "unit": "short" } , "overrides": [] }
    },

    {
      "id": 40, "type": "timeseries", "title": "badcase 各状态存量",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "rag_badcase_total", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2 } } , "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] } }
    },

    {
      "id": 50, "type": "timeseries", "title": "降级路由分布（按 reason）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (reason) (rate(rag_degraded_total[1h]))", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } , "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 51, "type": "timeseries", "title": "问答完成率（漏斗 completed / accepted）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(rag_stage_total{stage=\"completed\",result=\"succeeded\"}[1h])) / clamp_min(sum(rate(rag_stage_total{stage=\"accepted\",result=\"entered\"}[1h])), 1e-9)", "legendFormat": "completion_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0.9, "max": 1.0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.97 } ] } } , "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } }
    },
    {
      "id": 52, "type": "stat", "title": "采纳率（点赞 / 总反馈，1h）",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(rag_feedback_total{rating=\"up\"}[1h])) / clamp_min(sum(rate(rag_feedback_total[1h])), 1e-9)", "legendFormat": "adoption_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.85 } ] } } , "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 53, "type": "stat", "title": "反馈覆盖率（反馈数 / 完成回答，1h）",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(rag_feedback_total[1h])) / clamp_min(sum(rate(rag_stage_total{stage=\"completed\",result=\"succeeded\"}[1h])), 1e-9)", "legendFormat": "feedback_coverage" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "green", "value": 0.3 } ] } } , "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 54, "type": "stat", "title": "问题解决率（1 - 点踩率，样本 ≥20）",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "1 - (sum(rate(rag_feedback_total{rating=\"down\"}[1h])) / clamp_min(sum(rate(rag_feedback_total[1h])), 1e-9))", "legendFormat": "resolve_rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0.8, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.9 }, { "color": "green", "value": 0.95 } ] } } , "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
