# ===== 应用 =====
APP_NAME=外贸RAG知识库问答系统
APP_ENV=dev                 # dev / test / prod
LOG_LEVEL=INFO

# ===== 数据库（本地开发 SQLite，预发/生产 PostgreSQL）=====
# 本地开发（零依赖，默认）：
DATABASE_URL=sqlite:///./data/app.db
# 预发/生产（M6）：
# DATABASE_URL=postgresql+psycopg://rag:改成你的密码@127.0.0.1:5432/rag

# 生产建议 false：表结构只由 `alembic upgrade head` 变更，避免应用启动时隐式改库
DB_AUTO_CREATE=true
# 连接池（PG 才生效）：常驻 10 + 峰值 20，借连接最多等 10 秒
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# 语句超时兜底（毫秒）：慢查询不能把连接池占死
DB_STATEMENT_TIMEOUT_MS=10000
# SQLite 写锁等待（秒），仅 SQLite 生效
DB_BUSY_TIMEOUT_S=5

# ===== Redis（Celery 队列 / 限流 / 缓存）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Milvus 向量库 =====
MILVUS_URI=http://127.0.0.1:19530
# Collection 命名必须带 模型_维度 后缀（PRD 17.4 反锁定规则2）
MILVUS_COLLECTION=chunks_bge-m3_1024
# 向量库实现：milvus（生产） / memory（开发测试兜底，重启即清空）
VECTOR_STORE=memory

# ===== 嵌入器 =====
# auto（推荐：优先真实模型，失败降级 hash）/ bge-m3 / st（强制真实模型）/ hash（开发测试）
EMBED_PROVIDER=auto
# 真实嵌入模型：可填 HF/ModelScope 模型名，也可填本地目录（本地目录优先，离线可用）
# 下载：python scripts/download_model.py --model BAAI/bge-m3
EMBED_MODEL_NAME=BAAI/bge-m3
MODEL_CACHE_DIR=./models
# 国内镜像：HuggingFace 官方站被网络策略阻断，必须走镜像
HF_ENDPOINT=https://hf-mirror.com
EMBED_BATCH_SIZE=8
EMBED_MAX_LENGTH=1024

# ===== 重排（FR-205）=====
RERANK_ENABLED=true
# auto（有模型用交叉编码器，否则启发式）/ cross / heuristic / off
RERANK_PROVIDER=auto
RERANK_MODEL_NAME=BAAI/bge-reranker-base
RERANK_TOP_N=20

# ===== OCR（扫描件识别，FR-101/FR-104）=====
OCR_ENABLED=true
OCR_DPI=200
OCR_MIN_TEXT_CHARS=20      # 文本层少于该字符数视为扫描页
OCR_MIN_CONFIDENCE=0.85    # 低于该值标记人工抽检
OCR_MAX_PAGES=300

# ===== 认证 =====
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== LLM Provider（OpenAI 兼容协议）=====
# 选择优先级：MINIMAX > DEEPSEEK > QWEN（只认第一个配了 Key 的）
# MiniMax（国内站 api.minimaxi.com，国际站 api.minimax.io）
# 注意：MiniMax-M2 / M2.1 已下线；M3/M2.5/M2.7 会把 <think> 推理块写进正文，
#       代码已做流式剥离，但默认仍推荐不带思考的 Flash 版，首字更快。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
# 生成主：DeepSeek；生成备/翻译主：Qwen（PRD 15.4.2）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== 嵌入 / 重排（本地模型路径，M2 启用）=====
BGE_M3_MODEL_PATH=./models/bge-m3
BGE_RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# ===== 对象存储（上传文档，M2 启用）=====
STORAGE_DIR=./data/files
MAX_UPLOAD_MB=100

# ===== 结构化数据 / SQL 通道（M4 启用，PRD 7.4 五铁律）=====
# 业务库与 RAG 主库物理分离，应用以只读方式访问 4 个视图
TRADE_DB_PATH=./data/trade.db
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_MAX_ROWS=200
SQL_USER_RATE_PER_MIN=10
SQL_SESSION_RATE_PER_MIN=20
SQL_IP_RATE_PER_MIN=30
SQL_GLOBAL_QPS=50

# ===== 合规（M4 启用）=====
# 第三层 LLM 语义兜底开关（离线评测/无 Key 时可关；词库与规则层不受影响）
COMPLIANCE_LLM_CHECK=true
COMPLIANCE_EVENT_RETENTION_DAYS=180

# ===== 可观测 / 评测 / 前端（M5 启用）=====
# 进程内指标默认开启；多副本部署由 Prometheus 分别抓取 /metrics 再聚合
METRICS_ENABLED=true
# 非空时 /metrics 需要 Authorization: Bearer <token>（防指标外泄）
METRICS_TOKEN=
# 评测集目录（随仓库版本化）；评测报告写入 data/eval_reports/
EVAL_DIR=../eval
# 是否由后端托管静态前端（http://127.0.0.1:8000/app/）
FRONTEND_ENABLED=true

# ===== 异步摄入流水线（M6 步骤10-2）=====
# auto：向量库=memory 时用同进程线程（内存向量库不跨进程），Milvus 时用 Celery
# celery / thread / inline 可强制指定（inline = 请求内同步执行，仅测试排障）
INGEST_MODE=auto
# 本地验证：python scripts/local_redis.py up（端口 56379）
# 生产：redis://:密码@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_QUEUE=ingest
INGEST_MAX_ATTEMPTS=3
INGEST_STALE_SECONDS=900
INGEST_TASK_SOFT_TIME_LIMIT=1800
INGEST_TASK_TIME_LIMIT=2100
